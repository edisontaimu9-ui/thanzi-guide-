{
  "projectName": "Thanzi Guide",
  "databases": [
    {
      "$id": "thanzi_guide",
      "name": "Thanzi Guide",
      "enabled": true
    }
  ],
  "collections": [
    {
      "$id": "profiles",
      "$permissions": ["read(\"users\")", "create(\"users\")"],
      "databaseId": "thanzi_guide",
      "name": "Profiles",
      "enabled": true,
      "documentSecurity": true,
      "attributes": [
        { "key": "userId", "type": "string", "size": 36, "required": true },
        { "key": "name", "type": "string", "size": 128, "required": true },
        { "key": "role", "type": "string", "size": 32, "required": true, "default": "USER" },
        { "key": "avatarUrl", "type": "string", "size": 500, "required": false },
        { "key": "bio", "type": "string", "size": 1000, "required": false },
        { "key": "preferences", "type": "string", "size": 5000, "required": false }
      ],
      "indexes": [
        { "key": "userId_unique", "type": "unique", "attributes": ["userId"] }
      ]
    },
    {
      "$id": "categories",
      "$permissions": ["read(\"any\")", "create(\"label:editor\")", "update(\"label:editor\")", "delete(\"label:admin\")"],
      "databaseId": "thanzi_guide",
      "name": "Categories",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        { "key": "name", "type": "string", "size": 128, "required": true },
        { "key": "slug", "type": "string", "size": 128, "required": true },
        { "key": "type", "type": "string", "size": 32, "required": true },
        { "key": "description", "type": "string", "size": 500, "required": false }
      ],
      "indexes": [
        { "key": "slug_unique", "type": "unique", "attributes": ["slug"] },
        { "key": "type_idx", "type": "key", "attributes": ["type"] }
      ]
    },
    {
      "$id": "foods",
      "$permissions": ["read(\"any\")", "create(\"label:editor\")", "update(\"label:editor\")", "delete(\"label:admin\")"],
      "databaseId": "thanzi_guide",
      "name": "Foods",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        { "key": "name", "type": "string", "size": 200, "required": true },
        { "key": "localNames", "type": "string", "size": 100, "required": false, "array": true },
        { "key": "description", "type": "string", "size": 2000, "required": false },
        { "key": "categoryId", "type": "string", "size": 36, "required": false },
        { "key": "servingSize", "type": "string", "size": 100, "required": false },
        { "key": "calories", "type": "double", "required": false },
        { "key": "protein", "type": "double", "required": false },
        { "key": "carbs", "type": "double", "required": false },
        { "key": "fat", "type": "double", "required": false },
        { "key": "fiber", "type": "double", "required": false },
        { "key": "micronutrients", "type": "string", "size": 5000, "required": false },
        { "key": "imageUrl", "type": "string", "size": 500, "required": false },
        { "key": "preparationMethods", "type": "string", "size": 300, "required": false, "array": true },
        { "key": "notes", "type": "string", "size": 2000, "required": false },
        { "key": "sources", "type": "string", "size": 500, "required": false, "array": true },
        { "key": "status", "type": "string", "size": 16, "required": true, "default": "draft" }
      ],
      "indexes": [
        { "key": "name_fulltext", "type": "fulltext", "attributes": ["name"] },
        { "key": "status_idx", "type": "key", "attributes": ["status"] },
        { "key": "category_idx", "type": "key", "attributes": ["categoryId"] }
      ]
    },
    {
      "$id": "articles",
      "$permissions": ["read(\"any\")", "create(\"label:editor\")", "update(\"label:editor\")", "delete(\"label:admin\")"],
      "databaseId": "thanzi_guide",
      "name": "Articles",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        { "key": "title", "type": "string", "size": 300, "required": true },
        { "key": "slug", "type": "string", "size": 300, "required": true },
        { "key": "summary", "type": "string", "size": 500, "required": false },
        { "key": "body", "type": "string", "size": 50000, "required": true },
        { "key": "categoryId", "type": "string", "size": 36, "required": false },
        { "key": "tags", "type": "string", "size": 100, "required": false, "array": true },
        { "key": "featuredImage", "type": "string", "size": 500, "required": false },
        { "key": "authorId", "type": "string", "size": 36, "required": false },
        { "key": "status", "type": "string", "size": 16, "required": true, "default": "draft" },
        { "key": "publishedAt", "type": "datetime", "required": false },
        { "key": "updatedAt", "type": "datetime", "required": false },
        { "key": "sources", "type": "string", "size": 500, "required": false, "array": true }
      ],
      "indexes": [
        { "key": "slug_unique", "type": "unique", "attributes": ["slug"] },
        { "key": "status_idx", "type": "key", "attributes": ["status"] },
        { "key": "category_idx", "type": "key", "attributes": ["categoryId"] },
        { "key": "title_fulltext", "type": "fulltext", "attributes": ["title"] }
      ]
    },
    {
      "$id": "courses",
      "$permissions": ["read(\"any\")", "create(\"label:nutrition_expert\")", "update(\"label:nutrition_expert\")", "delete(\"label:admin\")"],
      "databaseId": "thanzi_guide",
      "name": "Courses",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        { "key": "title", "type": "string", "size": 200, "required": true },
        { "key": "slug", "type": "string", "size": 200, "required": true },
        { "key": "description", "type": "string", "size": 2000, "required": false },
        { "key": "coverImage", "type": "string", "size": 500, "required": false },
        { "key": "status", "type": "string", "size": 16, "required": true, "default": "draft" },
        { "key": "order", "type": "integer", "required": false, "default": 0 }
      ],
      "indexes": [
        { "key": "slug_unique", "type": "unique", "attributes": ["slug"] }
      ]
    },
    {
      "$id": "lessons",
      "$permissions": ["read(\"any\")", "create(\"label:nutrition_expert\")", "update(\"label:nutrition_expert\")", "delete(\"label:admin\")"],
      "databaseId": "thanzi_guide",
      "name": "Lessons",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        { "key": "courseId", "type": "string", "size": 36, "required": true },
        { "key": "title", "type": "string", "size": 200, "required": true },
        { "key": "slug", "type": "string", "size": 200, "required": true },
        { "key": "content", "type": "string", "size": 50000, "required": true },
        { "key": "order", "type": "integer", "required": false, "default": 0 },
        { "key": "status", "type": "string", "size": 16, "required": true, "default": "draft" }
      ],
      "indexes": [
        { "key": "course_idx", "type": "key", "attributes": ["courseId"] },
        { "key": "course_slug_unique", "type": "unique", "attributes": ["courseId", "slug"] }
      ]
    },
    {
      "$id": "quizzes",
      "$permissions": ["read(\"any\")", "create(\"label:nutrition_expert\")", "update(\"label:nutrition_expert\")", "delete(\"label:admin\")"],
      "databaseId": "thanzi_guide",
      "name": "Quizzes",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        { "key": "lessonId", "type": "string", "size": 36, "required": true },
        { "key": "title", "type": "string", "size": 200, "required": false }
      ],
      "indexes": [
        { "key": "lesson_idx", "type": "key", "attributes": ["lessonId"] }
      ]
    },
    {
      "$id": "questions",
      "$permissions": ["read(\"any\")", "create(\"label:nutrition_expert\")", "update(\"label:nutrition_expert\")", "delete(\"label:admin\")"],
      "databaseId": "thanzi_guide",
      "name": "Questions",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        { "key": "quizId", "type": "string", "size": 36, "required": true },
        { "key": "text", "type": "string", "size": 1000, "required": true },
        { "key": "order", "type": "integer", "required": false, "default": 0 }
      ],
      "indexes": [
        { "key": "quiz_idx", "type": "key", "attributes": ["quizId"] }
      ]
    },
    {
      "$id": "answers",
      "$permissions": ["read(\"any\")", "create(\"label:nutrition_expert\")", "update(\"label:nutrition_expert\")", "delete(\"label:admin\")"],
      "databaseId": "thanzi_guide",
      "name": "Answers",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        { "key": "questionId", "type": "string", "size": 36, "required": true },
        { "key": "text", "type": "string", "size": 500, "required": true },
        { "key": "isCorrect", "type": "boolean", "required": true, "default": false },
        { "key": "order", "type": "integer", "required": false, "default": 0 }
      ],
      "indexes": [
        { "key": "question_idx", "type": "key", "attributes": ["questionId"] }
      ]
    },
    {
      "$id": "user_progress",
      "$permissions": ["read(\"users\")", "create(\"users\")"],
      "databaseId": "thanzi_guide",
      "name": "User Progress",
      "enabled": true,
      "documentSecurity": true,
      "attributes": [
        { "key": "userId", "type": "string", "size": 36, "required": true },
        { "key": "courseId", "type": "string", "size": 36, "required": false },
        { "key": "lessonId", "type": "string", "size": 36, "required": false },
        { "key": "completed", "type": "boolean", "required": true, "default": false },
        { "key": "completedAt", "type": "datetime", "required": false }
      ],
      "indexes": [
        { "key": "user_idx", "type": "key", "attributes": ["userId"] },
        { "key": "user_lesson_unique", "type": "unique", "attributes": ["userId", "lessonId"] }
      ]
    },
    {
      "$id": "bookmarks",
      "$permissions": ["read(\"users\")", "create(\"users\")"],
      "databaseId": "thanzi_guide",
      "name": "Bookmarks",
      "enabled": true,
      "documentSecurity": true,
      "attributes": [
        { "key": "userId", "type": "string", "size": 36, "required": true },
        { "key": "itemType", "type": "string", "size": 16, "required": true },
        { "key": "itemId", "type": "string", "size": 36, "required": true }
      ],
      "indexes": [
        { "key": "user_idx", "type": "key", "attributes": ["userId"] },
        { "key": "user_item_unique", "type": "unique", "attributes": ["userId", "itemType", "itemId"] }
      ]
    },
    {
      "$id": "favorites",
      "$permissions": ["read(\"users\")", "create(\"users\")"],
      "databaseId": "thanzi_guide",
      "name": "Favorites",
      "enabled": true,
      "documentSecurity": true,
      "attributes": [
        { "key": "userId", "type": "string", "size": 36, "required": true },
        { "key": "foodId", "type": "string", "size": 36, "required": true }
      ],
      "indexes": [
        { "key": "user_idx", "type": "key", "attributes": ["userId"] },
        { "key": "user_food_unique", "type": "unique", "attributes": ["userId", "foodId"] }
      ]
    },
    {
      "$id": "references",
      "$permissions": ["read(\"any\")", "create(\"label:editor\")", "update(\"label:editor\")", "delete(\"label:admin\")"],
      "databaseId": "thanzi_guide",
      "name": "References",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        { "key": "title", "type": "string", "size": 300, "required": true },
        { "key": "url", "type": "string", "size": 500, "required": false },
        { "key": "publisher", "type": "string", "size": 200, "required": false },
        { "key": "year", "type": "integer", "required": false },
        { "key": "relatedType", "type": "string", "size": 16, "required": false },
        { "key": "relatedId", "type": "string", "size": 36, "required": false }
      ],
      "indexes": [
        { "key": "related_idx", "type": "key", "attributes": ["relatedId"] }
      ]
    }
  ],
  "buckets": [
    { "$id": "food_images", "name": "Food Images", "$permissions": ["read(\"any\")", "create(\"label:editor\")"], "fileSecurity": false, "enabled": true, "maximumFileSize": 5000000, "allowedFileExtensions": ["jpg", "jpeg", "png", "webp"] },
    { "$id": "article_images", "name": "Article Images", "$permissions": ["read(\"any\")", "create(\"label:editor\")"], "fileSecurity": false, "enabled": true, "maximumFileSize": 5000000, "allowedFileExtensions": ["jpg", "jpeg", "png", "webp"] },
    { "$id": "avatars", "name": "Avatars", "$permissions": ["read(\"any\")", "create(\"users\")"], "fileSecurity": true, "enabled": true, "maximumFileSize": 2000000, "allowedFileExtensions": ["jpg", "jpeg", "png", "webp"] }
  ]
}
